# skale-cron environment variables.
#
# Every job's HTTP call and Telegram alert route through <PROJECT>_* vars,
# resolved at runtime by tick.sh from the project slug passed on each
# crontab line (XPHERE, XKEDULE, ...). See tick.sh's header for the full
# resolution order. Telegram vars are optional everywhere: the service
# starts and runs jobs normally with none of them set — heartbeats still
# fire and failures still show up in stdout logs either way.

# --- xphere (active jobs — see crontab) ------------------------------------

XPHERE_BASE_URL=https://xphere.app                # xphere origin used to build each job's URL, and fixed target for the heartbeat POST regardless of which project's job ran
XPHERE_CRON_SECRET=                                # bearer token for xphere's /api/cron/* routes; also authenticates the heartbeat POST for every job, any project
OPERATOR_AUTOMATION_SECRET=                        # xphere-specific exception: scrape-reviews authenticates with this instead of XPHERE_CRON_SECRET (matches OPERATOR_AUTOMATION_SECRET on Coolify)

# --- Telegram alerting (optional; deferred until per-app bots exist) ------
# Leave every TELEGRAM_* var below empty until each app's own bot is
# created. tick.sh falls back to the shared _OPS pair when a project has no
# bot of its own configured yet, and skips alerting silently (logging one
# line to stdout) if neither is set.

TELEGRAM_BOT_TOKEN_XPHERE=                         # xphere's own bot token, once created
TELEGRAM_ALERT_CHAT_ID_XPHERE=                     # chat/group id that bot posts alerts to

TELEGRAM_BOT_TOKEN_OPS=                            # shared fallback bot, used by any project with no bot of its own yet
TELEGRAM_ALERT_CHAT_ID_OPS=                        # chat/group id for the shared ops bot

# --- runtime ----------------------------------------------------------------

TZ=UTC                                             # keep at UTC so crontab cadences below match the GitHub Actions `cron:` expressions they replace exactly

# ---------------------------------------------------------------------------
# PHASE 3/4 — uncomment as each project's crontab lines are enabled
# (see the matching commented block in ./crontab). Same per-project shape
# as xphere above: BASE_URL, CRON_SECRET, and its own Telegram bot pair.
# ---------------------------------------------------------------------------

# XKEDULE_BASE_URL=
# XKEDULE_CRON_SECRET=
# TELEGRAM_BOT_TOKEN_XKEDULE=
# TELEGRAM_ALERT_CHAT_ID_XKEDULE=

# SKALECLUB_BASE_URL=
# SKALECLUB_CRON_SECRET=
# TELEGRAM_BOT_TOKEN_SKALECLUB=
# TELEGRAM_ALERT_CHAT_ID_SKALECLUB=

# XTIMATOR_BASE_URL=
# XTIMATOR_CRON_SECRET=
# TELEGRAM_BOT_TOKEN_XTIMATOR=
# TELEGRAM_ALERT_CHAT_ID_XTIMATOR=
